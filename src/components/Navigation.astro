<nav class="navbar">
	<div class="nav-container">
		<a href="/" class="nav-logo">
			<span class="logo-icon">📄</span>
			ResumeBuilder
		</a>
		<ul class="nav-menu">
			<li class="nav-item">
				<a href="/" class="nav-link">Builder</a>
			</li>
			<li class="nav-item">
				<a href="/tips" class="nav-link">Tips & Prep</a>
